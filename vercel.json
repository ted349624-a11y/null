{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "frontend",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "testnet.nullfamily.fun"
        }
      ],
      "destination": "https://nullfamily.fun/:path*",
      "permanent": false
    },
    {
      "source": "/nft",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/nft.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/quests",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/quests.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/api/index-status/:n",
      "destination": "/api/history?status=1"
    },
    {
      "source": "/api/stats-check/:n",
      "destination": "/api/stats"
    }
  ],
  "functions": {
    "api/hidden.js": {
      "maxDuration": 30
    },
    "api/history.js": {
      "maxDuration": 30
    },
    "api/stats.js": {
      "maxDuration": 30
    }
  }
}
