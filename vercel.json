{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "frontend",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "testnet.nullfamily.fun"
        }
      ],
      "destination": "https://nullfamily.fun/",
      "permanent": false
    },
    {
      "source": "/:path((?!ethers\\.umd\\.min\\.js$|nft-config\\.js$|index\\.html$|launch$|c/0x[0-9a-fA-F]{40}$|favicon\\.ico$|apple-touch-icon\\.png$|apple-touch-icon-precomposed\\.png$|site\\.webmanifest$|icons/[a-z0-9.-]+$).+)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/launch",
      "destination": "/index.html"
    },
    {
      "source": "/c/:addr",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/hidden.js": {
      "maxDuration": 30
    },
    "api/history.js": {
      "maxDuration": 30
    },
    "api/stats.js": {
      "maxDuration": 30
    }
  }
}
