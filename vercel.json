{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "frontend",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "testnet.nullfamily.fun"
        }
      ],
      "destination": "https://nullfamily.fun/",
      "permanent": false
    },
    {
      "source": "/:path((?!ethers\\.umd\\.min\\.js$|nft-config\\.js$|index\\.html$).+)",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/hidden.js": {
      "maxDuration": 30
    },
    "api/history.js": {
      "maxDuration": 30
    },
    "api/stats.js": {
      "maxDuration": 30
    }
  }
}
