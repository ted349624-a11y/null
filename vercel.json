{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "testnet.nullfamily.fun"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/quests.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/hostprobe",
      "has": [
        {
          "type": "host",
          "value": "testnet.nullfamily.fun"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/hostprobe",
      "destination": "/quests.html"
    }
  ]
}
