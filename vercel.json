{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/nft",
      "destination": "/nft.html"
    },
    {
      "source": "/apply",
      "destination": "/apply.html"
    },
    {
      "source": "/api/index-status/:n",
      "destination": "/api/history?status=1"
    },
    {
      "source": "/api/stats-check/:n",
      "destination": "/api/stats"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "testnet.nullfamily.fun"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/quests.html"
    }
  ],
  "functions": {
    "api/hidden.js": {
      "maxDuration": 30
    },
    "api/history.js": {
      "maxDuration": 30
    },
    "api/stats.js": {
      "maxDuration": 30
    }
  }
}
